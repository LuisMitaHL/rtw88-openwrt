 	skb_queue_head_init(&rtwdev->coex.queue);
@@ -2412,7 +2415,8 @@ int rtw_register_hw(struct rtw_dev *rtwdev, struct ieee80211_hw *hw)
 	hw->wiphy->available_antennas_rx = hal->antenna_rx;
 
